#include <winver.h>
#include "version.h"

#ifndef GC_ORIGINAL_NAME
#define GC_ORIGINAL_NAME "gamecache.dll"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     GC_VERSION_MAJOR, GC_VERSION_MINOR, GC_VERSION_PATCH, 0
 PRODUCTVERSION  GC_VERSION_MAJOR, GC_VERSION_MINOR, GC_VERSION_PATCH, 0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "gamecache"
            VALUE "FileDescription",  "gamecache - lets Windows cache game data that is read unbuffered"
            VALUE "FileVersion",      GC_VERSION_STR
            VALUE "ProductVersion",   GC_VERSION_STR
            VALUE "OriginalFilename", GC_ORIGINAL_NAME
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
